{
  "name": "suture",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test:run": "vitest run",
    "test:watch": "vitest",
    "build": "pnpm --filter @suture/web build",
    "dev": "pnpm --filter @suture/web dev",
    "guards": "node scripts/vocabulary-guard.mjs && node scripts/check-line-limits.mjs",
    "ci:all": "pnpm typecheck && pnpm lint && pnpm test:run && pnpm build && pnpm guards"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "fast-check": "^3.22.0",
    "globals": "^16.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
